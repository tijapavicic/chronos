graph TB
    subgraph "  Hosting Platform: Main Components"
        apiController["SimulationController<br/>(REST Controller)<br/>Exposes simulation endpoints"]
        orchestrator["SimulationOrchestrator<br/>(Service)<br/>Coordinates simulation lifecycle"]
        jobScheduler["JobScheduler<br/>(Scheduler)<br/>Schedules jobs and retries"]
        jobRunner["JobRunner<br/>(Worker)<br/>Executes simulation jobs"]
        calcClient["CalculationClient<br/>(Client)<br/>Sends compute requests"]
        saSSideCar["SaS SideCar<br/>(sidecar)<br/>Sends requests to SaSRepository"]

        subgraph optional["Optional Components"]
            eventBus["EventBus<br/>(Messaging)<br/>Internal event bus"]
            cache["Cache<br/>(Cache/Redis)<br/>Optional cache"]
        end
    end

    subgraph external["External Systems"]
        calcEngine["Calculation Engine<br/>(External compute service)"]
        dataRepo["SaSRepository<br/>(Repository)<br/>Persists scenarios and results"]
        sasDb["SaS DB<br/>(Postgres / RDBMS)"]
    end

    apiController -->|REST/JSON| orchestrator
    orchestrator -->|Internal API / Cron| jobScheduler
    jobScheduler -->|Queue / internal API| jobRunner
    jobRunner -->|gRPC/HTTP| calcClient
    jobRunner -->|gRPC/HTTP| saSSideCar
    saSSideCar -->|gRPC/HTTP| dataRepo
    calcClient -->|gRPC/HTTP| calcEngine
    orchestrator -->|JDBC/SQL| dataRepo
    jobRunner -->|Messaging| eventBus
    orchestrator -->|Redis| cache
    dataRepo -->|JDBC/SQL| sasDb

    style optional fill:#f5f5f5
