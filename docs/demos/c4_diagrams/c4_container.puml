@startuml
' C4 Container diagram for Chronos
!define C4P https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master
!includeurl C4P/C4_Container.puml

LAYOUT_WITH_LEGEND()

Person(apiClient, "API Client", "External client using the REST API")

System_Boundary(chronos_sys, "Chronos") {
  Container(lb, "Load Balancer", "NGINX/Ingress", "Routes HTTP(S) traffic to app instances")
  Container(app, "Chronos API", "Spring Boot", "REST API managing facilities and simulations")
  ContainerDb(db, "Database", "H2 / RDBMS", "Stores facility data")
  Container(monitoring, "Monitoring", "Prometheus/Grafana", "Collects metrics and dashboards")
  Container(scheduler, "Scheduler", "Cron/Job Runner", "Triggers simulations and background tasks")
}

Rel(apiClient, lb, "Sends HTTP(S) requests to")
Rel(lb, app, "Forwards requests to")
Rel(app, db, "Reads from and writes to", "JDBC/SQL")
Rel(app, monitoring, "Pushes metrics to", "Prometheus metrics")
Rel(scheduler, app, "Triggers simulation endpoints via")

SHOW_LEGEND()
@enduml
