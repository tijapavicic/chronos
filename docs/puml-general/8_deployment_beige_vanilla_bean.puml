@startuml
title Chronos - Deployment Diagram (Beige Vanilla Bean Palette)

' Beige / Vanilla Bean color palette
skinparam backgroundColor #fbf9f6
skinparam node {
  BorderColor #C7A17A
  BackgroundColor #FFF8E7
  FontColor #4B3A2C
}
skinparam component {
  BackgroundColor #FFF3E0
  BorderColor #B88A5B
  FontColor #4B3A2C
}
skinparam artifact {
  BackgroundColor #FFF8E7
  BorderColor #C7A17A
}
skinparam database {
  BackgroundColor #F6EFE3
  BorderColor #B88A5B
  FontColor #4B3A2C
}
skinparam shadowing false

' Top-level external actor
actor "API Client" as Client #F6EAD6
Client --> LB : HTTPS

' Load balancer
node "Load Balancer" as LB #FBEAD0 {
  [NGINX] #F7D9B8
}

' Application cluster
cloud "Chronos App Cluster" #FFF6ED {
  node "App Node 1" as App1 #FFF8E7 {
    component "Chronos (Spring Boot)" as AppComp1
    artifact "chronos.jar" as Jar1
  }

  node "App Node 2" as App2 #FFF8E7 {
    component "Chronos (Spring Boot)" as AppComp2
    artifact "chronos.jar" as Jar2
  }
}

' Service/process mapping
AppComp1 -down-> AppComp2 : Replication / Scaling (stateless)

' Database node
database "H2 Database (or external DB)" as DB #F6EFE3 {
  [FACILITY Table]
}

' Persistence and repository
AppComp1 --> DB : JDBC
AppComp2 --> DB : JDBC

' Monitoring and logging
node "Monitoring" as Monitoring #FFF8E7 {
  component "Prometheus" as Prom
  component "Grafana" as Graf
}
AppComp1 --> Prom : metrics
AppComp2 --> Prom : metrics
Prom --> Graf : reads

' Optional: background job / scheduler
node "Scheduler" as Scheduler #FFF9F1 {
  component "Simulation Runner" as SimRunner
}
Scheduler --> AppComp1 : trigger simulation

' Notes and endpoints
note right of LB
  Public endpoint: https://api.example.com
  Routes traffic to app nodes
end note

note left of DB
  Persistence for facilities
  (can be H2 for demos or external RDBMS)
end note

' Deployment relationships
Client -> LB
LB -> App1
LB -> App2
App1 -> DB
App2 -> DB
App1 -> Monitoring
App2 -> Monitoring
Scheduler -> App1

@enduml
