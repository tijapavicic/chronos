flowchart TB
    classDef user        fill:#f1f5f9,stroke:#0f172a,color:#0f172a,font-weight:bold
    classDef frontend    fill:#dbeafe,stroke:#1e3a8a,color:#0f172a,font-weight:bold
    classDef backend     fill:#e0e7ff,stroke:#312e81,color:#111827,font-weight:bold
    classDef orchestrator fill:#ede9fe,stroke:#5b21b6,color:#1f2937,font-weight:bold
    classDef calc        fill:#fef3c7,stroke:#92400e,color:#1f2937,font-weight:bold
    classDef oltp        fill:#dcfce7,stroke:#14532d,color:#052e16,font-weight:bold
    classDef analytics   fill:#e2e8f0,stroke:#1e3a8a,color:#0f172a,font-weight:bold
    classDef queue       fill:#ffe4e6,stroke:#9f1239,color:#1f2937,font-weight:bold
    classDef future      fill:#cbd5f5,stroke:#3730a3,color:#120078,font-weight:bold
    classDef note        fill:#fffbeb,stroke:#d97706,color:#78350f,font-style:italic

    %% ── External actors ──────────────────────────────────────────────────────
    Modeler["👤 Modeler / Analyst\n─────────────────\nRuns simulations\nQueries results via BI"]:::user

    %% ── Presentation Layer ───────────────────────────────────────────────────
    subgraph UI_Layer["🖥️  Presentation Layer"]
        direction TB
        FE["Sim-Engine Frontend\n─────────────────\nReact SPA\nJob submission form\nReal-time status (SSE)"]:::frontend
    end

    %% ── Application Layer ────────────────────────────────────────────────────
    subgraph App_Layer["⚙️  Application Layer  —  Spring Boot"]
        direction LR
        BE["Sim-Engine Backend\n─────────────────\nSpring Boot · API Gateway\nAuth · Rate-limiting\nJob lifecycle management"]:::backend
        ORCH["Snapshot Orchestrator\n─────────────────\nSpring Boot · Spring Batch\nJob scheduling & retry\nCheckpoint management\nConsumes job-commands topic"]:::orchestrator
    end

    %% ── Compute Layer ────────────────────────────────────────────────────────
    subgraph Compute_Layer["🔢  Compute Layer"]
        direction TB
        CE["Calculation Engine\n─────────────────\nJVM Service\nStreaming query runner\nChunked bulk-insert pipeline\n1M rows × 50 cols per run"]:::calc
    end

    %% ── Data Layer ───────────────────────────────────────────────────────────
    subgraph Data_Layer["🗄️  Data Layer"]
        direction LR
        ODB[("DW / Operational DB\n─────────────────\nOracle RDBMS\nSource of record\nRead via streaming cursor")]:::oltp
        SDB[("Snapshot DB\n─────────────────\nAnalytics RDBMS\nPartitioned by system-id + date\n~450 MB per snapshot")]:::analytics
    end

    %% ── Phase 2 ──────────────────────────────────────────────────────────────
    subgraph Phase2["🔮  Phase 2 — Future Scope (not in 2026 roadmap)"]
        direction LR
        KQ["Kafka Queue\n─────────────────\nKafka · compacted topic\nAvro schema registry\nIdempotent producer"]:::queue
        P2DB[("Phase-2 Target DB\n─────────────────\nData Lake / Iceberg\nDownstream analytics\nManaged by consumer team")]:::future
    end

    %% ── Architecture notes ───────────────────────────────────────────────────
    subgraph Notes["📋  Architecture Notes"]
        direction LR
        N1["📌 Idempotent runs\nsnap_id dedup key\nretry-safe inserts"]:::note
        N2["📌 Observability\nPrometheus · OpenTelemetry\nGrafana dashboard"]:::note
        N3["📌 Security\nmTLS between services\nJWT at API Gateway\nKMS encrypted at rest"]:::note
    end

    %% ── Relationships (strict top-to-bottom, no cross-layer jumps) ───────────

    %% 1. Actor → Presentation
    Modeler      -->|"Browser / HTTPS TLS 1.3"| FE

    %% 2. Presentation ↔ Application
    FE           -->|"HTTPS / REST\nSubmit system-id + params"| BE
    BE           -->|"WebSocket / SSE\nJob status & progress %"| FE

    %% 3. Application → Application (same layer, horizontal)
    BE           -->|"Kafka topic: job-commands\nSnapshotJob event (Avro)"| ORCH

    %% 4. Application → Compute
    ORCH         -->|"gRPC unary / streaming\nJob contract + config"| CE
    ORCH         -.->|"Async callback\nSnapshotReady event"| BE

    %% 5. Compute ↔ Data
    CE           -->|"JDBC / SQL streaming\nServer-side cursor\nfetch 1M × 50 cols"| ODB
    ODB          -->|"Chunked SQL result\nbatched rows"| CE
    CE           -->|"Bulk insert\n~450 MB / 1M rows × 50 cols"| SDB

    %% 6. Application → Data (read path)
    BE           -->|"JDBC read replica\nServe UI + export"| SDB

    %% 7. Analyst direct DB access
    Modeler      -.->|"SQL / BI tool\nread-only access"| SDB

    %% 8. Phase 1 → Phase 2
    BE           -->|"Kafka publish\nAvro + schema registry\nsnapshot pointer + metadata"| KQ
    KQ           -->|"Kafka Connect / Sink\nat-least-once delivery"| P2DB
