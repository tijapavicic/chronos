    classDef backend fill:#e0e7ff,stroke:#312e81,color:#111827,font-weight:bold
    classDef calc fill:#fef3c7,stroke:#92400e,color:#1f2937,font-weight:bold
    classDef db fill:#e2e8f0,stroke:#1f2937,color:#0f172a,font-weight:bold
