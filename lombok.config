# Lombok configuration for Spring Boot 3.x + Java 17
# Place this file at the repository root to apply settings project-wide.

# ============================================================
# Constructor generation
# ============================================================

# Add @Generated annotation to all Lombok-generated code
# (useful for code coverage tools to exclude generated methods)
lombok.addLombokGeneratedAnnotation = true

# Make @RequiredArgsConstructor, @AllArgsConstructor etc. add @ConstructorProperties
# This helps with Jackson/JSON deserialization and better IDE support
lombok.anyConstructor.addConstructorProperties = true

# ============================================================
# @Builder configuration
# ============================================================

# Make @Builder generate "setterPrefix" so you can use fluent naming
# Example: .withName("x") instead of .name("x")
# Uncomment if you prefer "with" prefix:
# lombok.builder.className = *Builder
# lombok.accessors.chain = true
# lombok.accessors.fluent = false

# ============================================================
# Field defaults
# ============================================================

# Make all fields 'private final' by default when using @Value or @Data
lombok.fieldDefaults.defaultPrivate = true
lombok.fieldDefaults.defaultFinal = false

# ============================================================
# @ToString configuration
# ============================================================

# Don't include field names in toString() by default (more concise output)
# Set to true if you prefer fieldName=value format
lombok.toString.includeFieldNames = true

# Don't call super.toString() by default
lombok.toString.callSuper = skip

# Prevent accidental infinite loops when toString references parent objects
lombok.toString.doNotUseGetters = false

# ============================================================
# @EqualsAndHashCode configuration
# ============================================================

# Don't call super.equals/hashCode by default
lombok.equalsAndHashCode.callSuper = skip

# Don't use getters in equals/hashCode (direct field access is safer)
lombok.equalsAndHashCode.doNotUseGetters = true

# ============================================================
# Getter/Setter configuration
# ============================================================

# Use direct field access instead of getters in toString, equals, hashCode
# (avoids issues with lazy-loading, mocks, or overridden getters)
lombok.getter.lazy = false

# ============================================================
# @Log configuration
# ============================================================

# Use SLF4J as the default logging framework for @Slf4j
# (aligns with Spring Boot's default logging)
lombok.log.fieldName = log
lombok.log.fieldIsStatic = true

# ============================================================
# @NonNull configuration
# ============================================================

# Flag field name for @NonNull checks (used in generated null checks)
lombok.nonNull.exceptionType = NullPointerException
lombok.nonNull.flagUsage = warning

# ============================================================
# Copy annotations to generated code
# ============================================================

# Copy annotations from fields to constructors, getters, setters, builder
# Useful for validation annotations like @NotNull, @Valid
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonFormat
lombok.copyableAnnotations += jakarta.validation.constraints.NotNull
lombok.copyableAnnotations += jakarta.validation.constraints.NotBlank
lombok.copyableAnnotations += jakarta.validation.constraints.NotEmpty
lombok.copyableAnnotations += jakarta.validation.constraints.Min
lombok.copyableAnnotations += jakarta.validation.constraints.Max
lombok.copyableAnnotations += jakarta.validation.constraints.Size
lombok.copyableAnnotations += jakarta.validation.constraints.Pattern
lombok.copyableAnnotations += jakarta.validation.constraints.Email
lombok.copyableAnnotations += jakarta.validation.Valid

# ============================================================
# Compatibility and warnings
# ============================================================

# Flag usage of experimental features (helps avoid breaking changes)
lombok.experimental.flagUsage = warning

# Warn when using @Data on entity classes (prefer @Getter + @Setter for JPA entities)
lombok.data.flagUsage = warning

# Warn when using @Value (immutable) inappropriately
lombok.value.flagUsage = allow

# ============================================================
# IDE integration
# ============================================================

# Stop Lombok from complaining about newer Java versions
config.stopBubbling = true

# ============================================================
# Notes for developers
# ============================================================
# - Use @RequiredArgsConstructor for constructor injection in Spring beans
# - Use @Builder + @Jacksonized on DTOs for JSON serialization
# - Avoid @Data on JPA entities; prefer explicit @Getter/@Setter
# - Use @Slf4j for logging instead of manually creating logger instances
# - Place @EqualsAndHashCode.Exclude on fields that shouldn't participate in equality
# - Place @ToString.Exclude on sensitive fields (passwords, tokens) or circular references
