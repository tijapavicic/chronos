{
  "info": {
    "name": "Chronos API",
    "_postman_id": "chronos-collection-0001",
    "description": "Postman collection for Chronos API endpoints (with example tests and pre-request scripts)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "OpenAPI JSON",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v3/api-docs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "v3",
            "api-docs"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// If swagger credentials are present in the environment, add Basic Auth header",
              "if (pm.environment.get('swaggerUsername')) {",
              "    var auth = btoa(pm.environment.get('swaggerUsername') + ':' + pm.environment.get('swaggerPassword'));",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Basic ' + auth });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('OpenAPI endpoint returns 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var json = pm.response.json();",
              "pm.test('Response contains openapi', function () {",
              "    pm.expect(json).to.have.property('openapi');",
              "});",
              "pm.test('Paths include /simulation/ping', function () {",
              "    pm.expect(json.paths).to.have.property('/simulation/ping');",
              "});"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Example OpenAPI response",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v3/api-docs"
            }
          },
          "status": "OK",
          "code": 200,
          "_body": "{\n  \"openapi\": \"3.0.1\",\n  \"paths\": {\n    \"/simulation/ping\": {}\n  }\n}",
          "_postman_previewlanguage": "json"
        }
      ]
    },
